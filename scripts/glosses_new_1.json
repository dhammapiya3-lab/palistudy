"sabbattha": {"meaning": "어디에서나, 모든 곳에서", "grammar": "부사 (불변어)", "baseForm": "sabba (모든) + ttha (곳)", "formNote": "'sabbattha sotthiṃ gacchanti' = 어디서나 안녕에 이른다", "icon": "🌐"},
