{
"saṃghaṃ": {"meaning": "상가에, 승가에", "grammar": "남성명사, 대격 단수", "baseForm": "saṃgha = saṅgha (승가, 공동체)", "formNote": "saṅgha의 다른 표기(ṃ+gh). 'saraṇaṃ gacchāmi'의 대상이라 대격", "icon": "👥"},
"samādhimānantarikaññamāhu": {"meaning": "삼매를, 즉시 결과를 주는 [삼매]라고 말한다", "grammar": "연성 묶음: samādhiṃ(대격) + ānantarikaṃ(대격) + yaṃ(관계대명사) + āhu(동사 3인칭 복수 완료)", "baseForm": "samādhi + ānantarika + ya + āhu", "formNote": "samādhiṃ ānantarikaṃ yaṃ āhu → 연성으로 한 덩어리. ānantarika = 끊김 없이 곧바로 [결과를 주는]", "icon": "🧘"},
"vāpi": {"meaning": "또는, ~도", "grammar": "불변사 (vā + api)", "baseForm": "vā (또는) + api (~도)", "formNote": "vā + api → vāpi", "icon": "🔀"},
"yadatthi": {"meaning": "~인 것은 무엇이든 있는", "grammar": "연성: yad(관계대명사 중성 주격) + atthi(동사 3인칭 단수 현재)", "baseForm": "ya + atthi (있다)", "formNote": "yaṃ atthi → yad atthi → yadatthi. 'yadatthi kiñci' = 무엇이든 있는 것", "icon": "❓"},
"uda": {"meaning": "또는, 혹은", "grammar": "불변사 (접속사)", "baseForm": "uda", "formNote": "운문에서 vā와 같은 뜻으로 쓰임", "icon": "🔀"},
"cetasā": {"meaning": "마음으로, 뜻으로", "grammar": "중성명사, 구격 단수", "baseForm": "ceto (마음)", "formNote": "-as 어간: ceto → cetasā (구격). kāyena·vācā와 함께 '몸·말·뜻으로'", "icon": "💭"},
"virattacittāyatike": {"meaning": "미래에 대해 마음이 탐욕을 떠난", "grammar": "복합어, 처격 단수 (bhavasmiṃ과 호응)", "baseForm": "viratta (탐욕이 빛바랜) + citta (마음) + āyatika (미래의)", "formNote": "virattacittā + āyatike: '미래의 존재에 대해 탐욕을 떠난 마음을 가진'", "icon": "🍃"},
"ratanasuttaṃ": {"meaning": "보배경", "grammar": "중성명사, 주격 단수", "baseForm": "ratana (보배) + sutta (경)", "formNote": "'ratanasuttaṃ niṭṭhitaṃ' = 보배경이 끝났다", "icon": "💎"},
"sutaṃ": {"meaning": "들은 것, 들었다", "grammar": "과거분사, 중성 주격 단수", "baseForm": "suta < suṇāti (듣다)", "formNote": "'evaṃ me sutaṃ' = 이와 같이 나에 의해 들렸다 → 나는 들었다", "icon": "👂"},
"anāthapiṇḍikassa": {"meaning": "아나타삔디까의", "grammar": "남성 고유명사, 속격 단수", "baseForm": "Anāthapiṇḍika (급고독 장자)", "formNote": "'의지할 데 없는 이에게 먹을 것을 주는 자'라는 별명. 제따 숲 승원을 기증한 장자", "icon": "🏡"},
"ārāme": {"meaning": "승원에, 원림에", "grammar": "남성명사, 처격 단수", "baseForm": "ārāma (원림, 승원)", "formNote": "ārāma → ārāme (처격 -e)", "icon": "🌳"},
"bhikkhavoti": {"meaning": "\"비구들이여\"라고", "grammar": "남성명사, 호격 복수 + 인용 불변사 ti", "baseForm": "bhikkhu (비구)", "formNote": "bhikkhavo = 호격 복수(bhikkhave와 같은 뜻) + ti(인용 표시)", "icon": "📣"},
"bhadanteti": {"meaning": "\"존자시여\"라고", "grammar": "호격 + 인용 불변사 ti", "baseForm": "bhadanta (존자, 대덕)", "formNote": "bhadante = 호격 단수, 비구들이 부처님께 응답하는 말 + ti(인용)", "icon": "🙏"},
"taṃ": {"meaning": "그것을", "grammar": "지시대명사, 중성 대격 단수", "baseForm": "ta (그, 그것)", "formNote": "'taṃ suṇātha' = 그것을 들어라", "icon": "👉"},
"katamo": {"meaning": "무엇이, 어떤 것이", "grammar": "의문대명사, 남성 주격 단수", "baseForm": "katama (어느 것)", "formNote": "남성명사(maggo, sammāsaṅkappo 등)를 물을 때 katamo", "icon": "❓"},
"katamā": {"meaning": "무엇이, 어떤 것이", "grammar": "의문대명사, 여성 주격 단수", "baseForm": "katama (어느 것)", "formNote": "여성명사(sammādiṭṭhi, sammāvācā 등)를 물을 때 katamā", "icon": "❓"},
"dukkhe": {"meaning": "괴로움에 대한, 괴로움에서", "grammar": "중성명사, 처격 단수", "baseForm": "dukkha (괴로움)", "formNote": "dukkha → dukkhe (처격). 'dukkhe ñāṇaṃ' = 괴로움에 대한 앎", "icon": "😣"},
"yā": {"meaning": "~인 것 (그것)", "grammar": "관계대명사, 여성 주격 단수", "baseForm": "ya (~인 것)", "formNote": "여성명사 veramaṇī·vācā와 호응. ayaṃ과 짝을 이룸", "icon": "🔗"},
"dhammehi": {"meaning": "법들에서", "grammar": "남성명사, 탈격 복수 (구격과 같은 꼴)", "baseForm": "dhamma (법, 현상)", "formNote": "vivicca(떨어져서)와 함께 '~에서 떨어져' — 탈격 의미", "icon": "📜"},
"sukhañca": {"meaning": "행복도, 그리고 행복을", "grammar": "중성명사 대격 단수 + ca", "baseForm": "sukha (행복, 즐거움)", "formNote": "sukhaṃ + ca → sukhañca (ṃ이 ñ로 바뀜)", "icon": "😊"},
"kāyena": {"meaning": "몸으로", "grammar": "남성명사, 구격 단수", "baseForm": "kāya (몸)", "formNote": "kāya → kāyena (구격 -ena)", "icon": "🧍"},
"sukhavihārīti": {"meaning": "\"행복하게 머무는 자\"라고", "grammar": "형용사(남성 주격 단수) + 인용 ti", "baseForm": "sukha (행복) + vihārin (머무는 자)", "formNote": "sukhavihārī + ti → 인용 어미 앞에서 장음 유지", "icon": "😌"},
"sukhassa": {"meaning": "행복의, 즐거움의", "grammar": "중성명사, 속격 단수", "baseForm": "sukha (행복)", "formNote": "'sukhassa ca pahānā' = 행복을 버림으로써", "icon": "😊"},
"pahānā": {"meaning": "버림으로써, 버리기 때문에", "grammar": "중성명사, 탈격 단수", "baseForm": "pahāna (버림)", "formNote": "탈격이 원인·이유를 나타냄: '~을 버렸으므로'", "icon": "🗑️"},
"dukkhassa": {"meaning": "괴로움의", "grammar": "중성명사, 속격 단수", "baseForm": "dukkha (괴로움)", "formNote": "'dukkhassa ca pahānā' = 괴로움을 버림으로써", "icon": "😣"},
"yantasantaṃ": {"meaning": "그 고요한 [경지]를", "grammar": "연성: yaṃ(관계대명사 대격) + taṃ(지시대명사 대격) + santaṃ(형용사 대격)", "baseForm": "ya + ta + santa (고요한)", "formNote": "yaṃ taṃ santaṃ padaṃ = '그 고요한 경지를' (열반)", "icon": "🕊️"},
"cassa": {"meaning": "그리고 ~이어야 한다", "grammar": "연성: ca(그리고) + assa(동사 3인칭 단수 가능법)", "baseForm": "ca + atthi(있다)의 가능법 assa", "formNote": "ca assa → cassa. '~이어야 할 것이다'", "icon": "✅"},
"va": {"meaning": "~처럼, 또는 / 바로 (강조)", "grammar": "불변사", "baseForm": "va = eva / iva / vā", "formNote": "문맥에 따라 강조(eva), 비유(iva), 선택(vā)의 줄임꼴", "icon": "✨"},
"keci": {"meaning": "어떤 ~이든", "grammar": "부정대명사, 남성 주격 복수", "baseForm": "ko + ci (누구든)", "formNote": "'ye keci' = 무엇이든 ~인 것들", "icon": "❔"},
"pāṇabhūtatthi": {"meaning": "살아 있는 존재들이 있다", "grammar": "연성: pāṇabhūtā(복합어 주격 복수) + atthi(동사)", "baseForm": "pāṇa (생명) + bhūta (존재) + atthi (있다)", "formNote": "pāṇabhūtā atthi → pāṇabhūtatthi", "icon": "🐾"},
"vanavasesā": {"meaning": "또는 남김없이", "grammar": "연성: vā + anavasesā(형용사 주격 복수)", "baseForm": "vā (또는) + anavasesa (남김없는)", "formNote": "vā anavasesā → vanavasesā", "icon": "♾️"},
"vasanti": {"meaning": "산다, 머문다", "grammar": "동사, 현재 3인칭 복수", "baseForm": "vasati (살다)", "formNote": "단수 vasati → 복수 vasanti", "icon": "🏠"},
"paro": {"meaning": "다른 이가, 남이", "grammar": "대명형용사, 남성 주격 단수", "baseForm": "para (다른, 남)", "formNote": "'na paro paraṃ' = 남이 남을 ~하지 않기를", "icon": "👤"},
"paraṃ": {"meaning": "다른 이를, 남을", "grammar": "대명형용사, 남성 대격 단수", "baseForm": "para (다른, 남)", "formNote": "paro(주격) ↔ paraṃ(대격)", "icon": "👥"},
"nikubbetha": {"meaning": "속이기를, 기만하기를", "grammar": "동사, 가능법 3인칭 단수 (중간태)", "baseForm": "nikubbati (속이다)", "formNote": "na와 함께 '속이지 않기를'", "icon": "🎭"},
"katthaci": {"meaning": "어디서든", "grammar": "부사 (불변어)", "baseForm": "kattha (어디) + ci", "formNote": "'na katthaci' = 어디서도 ~않다", "icon": "📍"},
"kañci": {"meaning": "누구라도, 아무도", "grammar": "부정대명사, 남성 대격 단수", "baseForm": "ko + ci (누구든)", "formNote": "kaṃ + ci → kañci. 'na kañci' = 아무도 ~않다", "icon": "❔"},
"yathā": {"meaning": "~처럼, ~듯이", "grammar": "관계부사 (불변어)", "baseForm": "yathā", "formNote": "'mātā yathā' = 어머니가 ~하듯이", "icon": "↔️"},
"niyaṃ": {"meaning": "자기의, 자신의", "grammar": "형용사, 남성 대격 단수", "baseForm": "niya (자기 것)", "formNote": "puttaṃ(아들을)을 꾸밈", "icon": "🫶"},
"puttamāyusā": {"meaning": "아들을 목숨으로써", "grammar": "연성: puttaṃ(남성명사 대격) + āyusā(중성명사 구격)", "baseForm": "putta (아들) + āyu (목숨)", "formNote": "puttaṃ āyusā → puttamāyusā. '목숨을 걸고 아들을'", "icon": "👶"},
"ekaputtamanurakkhe": {"meaning": "외아들을 보호하듯이", "grammar": "연성: ekaputtaṃ(대격) + anurakkhe(동사 가능법 3인칭 단수)", "baseForm": "eka (하나) + putta (아들) + anurakkhati (보호하다)", "formNote": "ekaputtaṃ anurakkhe → ekaputtamanurakkhe", "icon": "🤱"},
"mettañca": {"meaning": "자애를, 그리고 자애를", "grammar": "여성명사 대격 단수 + ca", "baseForm": "mettā (자애)", "formNote": "mettaṃ + ca → mettañca. mānasaṃ(마음)과 함께 '자애의 마음을'", "icon": "💗"},
"sabbalokasmi": {"meaning": "온 세상에 대해", "grammar": "복합어, 처격 단수", "baseForm": "sabba (모든) + loka (세상)", "formNote": "-smiṃ 처격의 운문형 -smi", "icon": "🌏"},
"averamasapattaṃ": {"meaning": "원한 없고 적 없는", "grammar": "연성: averaṃ(형용사 대격) + asapattaṃ(형용사 대격)", "baseForm": "a (없음) + vera (원한) / a + sapatta (적)", "formNote": "averaṃ asapattaṃ → averamasapattaṃ", "icon": "🕊️"},
"tiṭṭhaṃ": {"meaning": "서 있으면서", "grammar": "현재분사, 남성 주격 단수", "baseForm": "tiṭṭhati (서다)", "formNote": "tiṭṭhanta의 주격 tiṭṭhaṃ = 서 있는 자", "icon": "🧍"},
"caraṃ": {"meaning": "걸으면서", "grammar": "현재분사, 남성 주격 단수", "baseForm": "carati (가다, 다니다)", "formNote": "caranta의 주격 caraṃ = 걷는 자", "icon": "🚶"},
"jātuggabbhaseyya": {"meaning": "결코 다시 모태에 [들지 않는다]", "grammar": "연성: jātu(불변사, 결코) + gabbhaseyyaṃ(복합어 대격)", "baseForm": "jātu (결코) + gabbha (모태) + seyyā (누움)", "formNote": "jātu gabbhaseyyaṃ → jātuggabbhaseyya (자음 겹침, 운율상 ṃ 생략)", "icon": "🚫"},
"punaretīti": {"meaning": "다시 온다 라고", "grammar": "연성: punar(부사) + eti(동사 3인칭 단수) + iti(인용)", "baseForm": "puna (다시) + eti (가다, 오다) + iti", "formNote": "puna eti iti → punaretīti (r은 연결음)", "icon": "🔁"},
"mettasuttaṃ": {"meaning": "자애경", "grammar": "중성명사, 주격 단수", "baseForm": "mettā (자애) + sutta (경)", "formNote": "'mettasuttaṃ niṭṭhitaṃ' = 자애경이 끝났다", "icon": "💗"},
"atha": {"meaning": "그때, 그러자", "grammar": "불변사 (접속부사)", "baseForm": "atha", "formNote": "'atha kho' = 그때에", "icon": "⏩"},
"aññatarā": {"meaning": "어떤, 한", "grammar": "대명형용사, 여성 주격 단수", "baseForm": "aññatara (어떤 하나의)", "formNote": "devatā(여성)를 꾸밈: '어떤 천신'", "icon": "❔"},
"abhikkantavaṇṇā": {"meaning": "빼어난 모습을 한, 광채가 뛰어난", "grammar": "복합어 형용사, 여성 주격 단수", "baseForm": "abhikkanta (빼어난) + vaṇṇa (모습, 빛깔)", "formNote": "devatā를 꾸밈", "icon": "✨"},
"kevalakappaṃ": {"meaning": "온통, 전체를", "grammar": "부사적 대격 (복합어)", "baseForm": "kevala (온전한) + kappa (같은)", "formNote": "'kevalakappaṃ jetavanaṃ' = 제따 숲 전체를", "icon": "🌐"},
"jetavanaṃ": {"meaning": "제따 숲을", "grammar": "중성 고유명사, 대격 단수", "baseForm": "Jetavana (제따 숲)", "formNote": "obhāsetvā(비추고)의 목적어라 대격", "icon": "🌳"},
"yena": {"meaning": "~가 있는 곳으로", "grammar": "관계대명사, 구격 단수 (부사적)", "baseForm": "ya (~인 것)", "formNote": "'yena bhagavā tenupasaṅkami' = 세존께서 계신 곳으로 다가갔다", "icon": "➡️"},
"tenupasaṅkami": {"meaning": "그곳으로 다가갔다", "grammar": "연성: tena(지시대명사 구격) + upasaṅkami(동사 아오리스트 3인칭 단수)", "baseForm": "ta + upasaṅkamati (다가가다)", "formNote": "tena upasaṅkami → tenupasaṅkami", "icon": "🚶"},
"upasaṅkamitvā": {"meaning": "다가가서", "grammar": "절대분사 (-tvā)", "baseForm": "upasaṅkamati (다가가다)", "formNote": "upa + saṃ + √kam + itvā", "icon": "🚶"},
"bhagavantaṃ": {"meaning": "세존께, 세존을", "grammar": "남성명사, 대격 단수", "baseForm": "bhagavant (세존)", "formNote": "주격 bhagavā ↔ 대격 bhagavantaṃ", "icon": "🙏"},
"ṭhitā": {"meaning": "선, 서 있는", "grammar": "과거분사, 여성 주격 단수", "baseForm": "tiṭṭhati (서다)", "formNote": "√ṭhā + ita. 'ekamantaṃ ṭhitā' = 한쪽에 선", "icon": "🧍"},
"sā": {"meaning": "그녀는, 그", "grammar": "지시대명사, 여성 주격 단수", "baseForm": "ta (그)", "formNote": "'sā devatā' = 그 천신은", "icon": "👉"},
"bahū": {"meaning": "많은", "grammar": "형용사, 남성 주격 복수", "baseForm": "bahu (많은)", "formNote": "devā·manussā(복수)를 꾸밈", "icon": "🔢"},
"devā": {"meaning": "신들이", "grammar": "남성명사, 주격 복수", "baseForm": "deva (신)", "formNote": "deva → devā (주격 복수)", "icon": "👼"},
"manussā": {"meaning": "인간들이", "grammar": "남성명사, 주격 복수", "baseForm": "manussa (인간)", "formNote": "manussa → manussā (주격 복수)", "icon": "🧑‍🤝‍🧑"},
"maṅgalāni": {"meaning": "축복들을, 길상들을", "grammar": "중성명사, 대격 복수", "baseForm": "maṅgala (축복, 길상)", "formNote": "acintayuṃ(생각했다)의 목적어", "icon": "🌸"},
"yassa": {"meaning": "~인 그의", "grammar": "관계대명사, 남성 속격 단수", "baseForm": "ya (~인 사람)", "formNote": "'cittaṃ yassa na kampati' = 그 마음이 흔들리지 않는 사람", "icon": "🔗"},
"etādisāni": {"meaning": "이와 같은 것들을", "grammar": "형용사, 중성 대격 복수", "baseForm": "etādisa (이러한)", "formNote": "앞서 말한 38가지 축복을 가리킴", "icon": "👉"},
